# Copy to .env and fill in values

# Database (auto-configured in Docker)
DATABASE_URL=postgresql+asyncpg://northbridge:northbridge@localhost:5432/northbridge

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# AI analysis (optional — get from console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=

# Email (optional — for digest alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

ENVIRONMENT=development
