# ============================================================
# FUNDING RATE ARBITRAGE BOT - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# BYBIT CREDENTIALS
# Create API keys at: https://www.bybit.com/app/user/api-management
# Permissions needed: Read, Trade (Spot + Derivatives)
# ------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# ------------------------------------------------------------
# OKX CREDENTIALS
# Create API keys at: https://www.okx.com/account/my-api
# Permissions needed: Read, Trade (Spot + Futures)
# ------------------------------------------------------------
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_api_passphrase_here

# ------------------------------------------------------------
# TRADING MODE
# Set PAPER_MODE=False to enable live trading (also requires --live --confirm --yes flags)
# Default: True (paper/simulation mode)
# ------------------------------------------------------------
PAPER_MODE=True

# Starting virtual balance for paper mode (USDC)
PAPER_STARTING_BALANCE=10000.0

# ------------------------------------------------------------
# ENTRY / EXIT THRESHOLDS
# ------------------------------------------------------------

# Minimum funding rate to enter a position (per 8h)
# 0.0003 = 0.03% per 8h = ~32.85% annualized
MIN_FUNDING_RATE=0.0003

# Funding rate below which we consider exiting (per 8h)
# 0.00005 = 0.005% per 8h = ~0.55% annualized
EXIT_FUNDING_RATE=0.00005

# Number of consecutive 8h cycles below EXIT_FUNDING_RATE before closing
EXIT_CONSECUTIVE_CYCLES=3

# ------------------------------------------------------------
# POSITION SIZING
# ------------------------------------------------------------

# Maximum percentage of portfolio per single position (0.15 = 15%)
MAX_POSITION_SIZE_PCT=0.15

# Maximum simultaneous open positions
MAX_TOTAL_POSITIONS=8

# Keep this fraction of margin free to avoid liquidation risk (0.25 = 25%)
MARGIN_BUFFER_PCT=0.25

# Minimum position size in USDC (below this we skip the trade)
MIN_POSITION_USDC=50

# Maximum position size in USDC (cap per trade)
MAX_POSITION_USDC=2000

# ------------------------------------------------------------
# TIMING
# ------------------------------------------------------------

# Seconds between market scans
SCAN_INTERVAL=60

# ------------------------------------------------------------
# RISK MANAGEMENT
# ------------------------------------------------------------

# Daily loss limit as fraction of portfolio; triggers trading halt (0.05 = 5%)
DAILY_LOSS_LIMIT_PCT=0.05

# ------------------------------------------------------------
# LOGGING & STORAGE
# ------------------------------------------------------------

# Log file path (relative to bot directory)
LOG_FILE=funding_bot.log

# SQLite database file path (relative to bot directory)
DB_FILE=funding_bot.db

# ------------------------------------------------------------
# TELEGRAM ALERTS (optional)
# Create a bot via @BotFather and get your chat ID via @userinfobot
# Leave blank to disable Telegram notifications
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
