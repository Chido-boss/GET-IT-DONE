# ─────────────────────────────────────────────────────────────────────────────
# Polymarket Latency Arbitrage Bot — Environment Variable Reference
# Copy to .env and fill in your values. Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Polymarket Credentials ────────────────────────────────────────────────────
# Obtain from https://polymarket.com/profile → API Keys
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_base64_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# ── Wallet (for live trading) ─────────────────────────────────────────────────
# EVM wallet address and private key — KEEP PRIVATE KEY SECURE
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=0xYourPrivateKeyHere

# ── Trading Mode ──────────────────────────────────────────────────────────────
# Set PAPER_MODE=false AND all three live flags to true for real trading
PAPER_MODE=true
LIVE_FLAG_1=false
LIVE_FLAG_2=false
LIVE_FLAG_3=false

# ── Paper Trading ─────────────────────────────────────────────────────────────
PAPER_STARTING_BALANCE=1000.0
PAPER_SLIPPAGE_PCT=0.001

# ── Strategy Parameters ───────────────────────────────────────────────────────
MIN_EDGE_PCT=5.0
MIN_CONFIDENCE=0.85
MAX_POSITION_PCT=0.08
KELLY_FRACTION=0.5
LAG_THRESHOLD_BASE=3.0
MOMENTUM_WINDOW=30
VOLATILITY_WINDOW=300
MIN_MARKET_LIQUIDITY=50000
DEDUP_WINDOW_MS=500
MAX_CONCURRENT_POSITIONS=10

# ── Risk Limits ───────────────────────────────────────────────────────────────
DAILY_LOSS_LIMIT_PCT=0.20
PER_ASSET_LOSS_LIMIT_PCT=0.10
TOTAL_DRAWDOWN_KILL_PCT=0.40

# ── Telegram Alerts (optional) ────────────────────────────────────────────────
# Create a bot via @BotFather and get the chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging & Storage ─────────────────────────────────────────────────────────
LOG_FILE=bot.log
DB_FILE=bot.db
