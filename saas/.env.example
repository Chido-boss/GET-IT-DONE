# ── Core ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string-in-production
PW_SALT=change-this-salt-too
BASE_URL=https://your-app.up.railway.app
HTTPS=true

# ── Database ──────────────────────────────────────────────────────────────────
DB_FILE=cryptowatch.db

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather → get the token
TELEGRAM_BOT_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create two recurring prices in Stripe Dashboard, then paste the price IDs:
STRIPE_STARTER_PRICE_ID=price_...   # £9.99/month
STRIPE_PRO_PRICE_ID=price_...       # £24.99/month
